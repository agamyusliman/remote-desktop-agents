# ── remot-agent configuration (copy to .env or export in your shell) ──
# Server
HOST=0.0.0.0
PORT=8788

# Project directory opened by omp
OMP_CWD=$HOME/Documents/Ai
# Directories the project/file explorer may read
ALLOWED_ROOTS=$HOME/Documents/Ai

# omp binary
OMP_BIN=/opt/homebrew/bin/omp
# tmux binary (optional)
TMUX_BIN=/opt/homebrew/bin/tmux

# Stream
CAPTURE_FPS=5
JPEG_QUALITY=62
CAPTURE_RESOLUTION=720p

# Access token. If unset, a random token is generated into data/token.
# REMOTE_TOKEN=

# Public HTTPS URL shown in Settings (set by your tunnel if you use one)
# PUBLIC_URL=https://your-tunnel.example.com

# Data directory (token, secret, projects.json, logs)
REMOTE_DATA=./data

# Login session lifetime (days). One year by default; 1–3650.
SESSION_TTL_DAYS=365

# Desktop shell: set 1 to run as a tray/menu-bar app with QR onboarding.
# REMOT_AGENT_DESKTOP=1

# Tunnel autostart at login (used by scripts/remot-agent-boot.sh)
REMOT_AGENT_TUNNEL=0
